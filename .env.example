ZENDESK_SUBDOMAIN=xxx
ZENDESK_EMAIL=xxx
ZENDESK_API_TOKEN=xxx
# Defaults allow standard ticket writes and Community posts/comments.
# Restrict all writes: ZENDESK_WRITE_MODE=read_only
# Restrict Community public writes only: ZENDESK_ENABLE_PUBLIC_WRITES=false
# Destructive writes, impersonation, and external uploads remain disabled by default.
# Optional conditional capabilities:
# ZENDESK_CAPABILITIES=support,operations,guide,community,csat,custom_objects,git_zen,time_tracking,badges
# ZENDESK_GIT_ZEN_FIELD_ID=123456789
# Optional Time Tracking app backend: configure both distinct field IDs.
# ZENDESK_TIME_TRACKING_TOTAL_FIELD_ID=123456790
# ZENDESK_TIME_TRACKING_LAST_FIELD_ID=123456791
